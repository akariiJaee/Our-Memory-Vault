rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the two accounts you create in Authentication > Users can read or write.
    // There is no public sign-up in the app, so no one else can ever get an account.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
